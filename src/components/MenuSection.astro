---
import type { MenuSection } from '../data/menu.ts';
import { superCategories } from '../data/categories.ts';
import CoffeeGlass from './CoffeeGlass.astro';

interface Props {
  section: MenuSection;
}

const { section } = Astro.props;

const superCat = superCategories.find(sc => sc.sections.includes(section.category));
const image = superCat?.sections[0] === section.category ? superCat.image : undefined;
const imageSizeClass =
  superCat?.label === "Promos Coworkers"       ? "h-8 md:h-10 w-auto opacity-75"  :
  superCat?.label === "Desayunos y Meriendas" ? "h-10 md:h-12 w-auto opacity-75" :
  superCat?.label === "Infusiones"             ? "h-12 md:h-14 w-auto opacity-75" :
                                                 "h-20 md:h-24 w-auto opacity-75";
---

<section class="mb-16">
  <h2 class="text-xs font-semibold tracking-[0.2em] uppercase text-gris mb-6 pb-3 border-b border-gris/20 flex items-center justify-between">
    <span>{section.category}</span>
    {image && <img src={image} alt="" class={imageSizeClass} />}
  </h2>

  {section.category === "Infusiones" && (
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-6 -mt-2">
      {[
        { color: "#27241c", label: "Café" },
        { color: "#e6e3df", label: "Leche" },
        { color: "#f5f3f0", label: "Espuma" },
        { color: "#776358", label: "Chocolate" },
        { color: "#c8d8e4", label: "Agua" },
      ].map(({ color, label }) => (
        <div class="flex items-center gap-1.5">
          <span
            class="inline-block w-3 h-3 shrink-0"
            style={`background-color: ${color}; outline: 1px solid #2a2b2a;`}
          />
          <span class="text-xs text-gris/60">{label}</span>
        </div>
      ))}
    </div>
  )}

  <ul class="grid grid-cols-1 md:grid-cols-2 md:gap-x-12" data-menu-section>
    {section.items.map((item) => (
      <li
        class={`pb-6 mb-6 border-b border-gris/10 last:border-0 last:mb-0 last:pb-0${item.image ? ' cursor-pointer select-none' : ''}`}
        {...(item.image ? { 'data-menu-item': '' } : {})}
      >
        <div class="flex items-center gap-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-[0.9375rem] font-medium leading-snug text-gris">
                {item.name}
                {item.tags?.includes('sin-tacc') && (
                  <span class="ml-2 px-2 py-0.5 text-xs font-medium rounded-full bg-dulce/15 text-dulce align-middle">
                    Sin TACC
                  </span>
                )}
                {item.image && (
                  <svg
                    data-chevron
                    class="inline-block ml-1.5 align-middle"
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    style="transition: transform 0.3s ease;"
                  >
                    <path d="M2 4L6 8L10 4" stroke="#a47c53" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
              </span>
              <span
                class="shrink-0 text-gris/40 tabular-nums text-sm"
                set:html={item.price === 0 ? '&mdash;' : '$' + item.price.toLocaleString('es-AR')}
              />
            </div>

            {item.description && (
              <p class="mt-1.5 text-sm text-gris/70 leading-relaxed">{item.description}</p>
            )}

            {item.optional && (
              <p class="mt-1 text-xs italic text-dulce">{item.optional}</p>
            )}

            {item.image && (
              <div
                data-image-container
                style="max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.3s ease, opacity 0.3s ease;"
              >
                <img
                  src={item.image}
                  alt={item.name}
                  class="mt-3 rounded-lg w-full object-contain"
                  onerror="var li=this.closest('[data-menu-item]');if(li){li.removeAttribute('data-menu-item');li.classList.remove('cursor-pointer','select-none');var c=li.querySelector('[data-chevron]');if(c)c.style.display='none';}"
                />
              </div>
            )}
          </div>

          {item.composition && (
            <CoffeeGlass layers={item.composition.layers} />
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<script>
  document.querySelectorAll('[data-menu-section]').forEach((section) => {
    let openItem: Element | null = null;

    section.addEventListener('click', (e) => {
      const li = (e.target as Element).closest('[data-menu-item]');
      if (!li) return;

      const container = li.querySelector('[data-image-container]') as HTMLElement | null;
      const chevron = li.querySelector('[data-chevron]') as HTMLElement | null;
      if (!container || !chevron) return;

      const isOpen = li.getAttribute('data-open') === 'true';

      if (openItem && openItem !== li) {
        const prevContainer = openItem.querySelector('[data-image-container]') as HTMLElement | null;
        const prevChevron = openItem.querySelector('[data-chevron]') as HTMLElement | null;
        if (prevContainer) {
          prevContainer.style.maxHeight = '0';
          prevContainer.style.opacity = '0';
        }
        if (prevChevron) prevChevron.style.transform = 'rotate(0deg)';
        openItem.setAttribute('data-open', 'false');
        openItem = null;
      }

      if (isOpen) {
        container.style.maxHeight = '0';
        container.style.opacity = '0';
        chevron.style.transform = 'rotate(0deg)';
        li.setAttribute('data-open', 'false');
        openItem = null;
      } else {
        container.style.maxHeight = container.scrollHeight + 'px';
        container.style.opacity = '1';
        chevron.style.transform = 'rotate(180deg)';
        li.setAttribute('data-open', 'true');
        openItem = li;
      }
    });
  });
</script>
