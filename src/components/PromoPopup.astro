---
import { supabase } from '../lib/supabase';

const { data: activePromo } = await supabase
  .from('promos')
  .select('id, title, image_path, expires_at')
  .eq('is_active', true)
  .or('expires_at.is.null,expires_at.gte.' + new Date().toISOString().split('T')[0])
  .limit(1)
  .single();
---

{activePromo && (
  <div
    id="promo-popup"
    class="fixed inset-0 z-50 hidden flex items-center justify-center backdrop-blur-md bg-black/20 p-4 cursor-pointer"
  >
    <div class="relative w-fit max-w-[500px] rounded-2xl overflow-hidden">
      <button
        id="promo-popup-close"
        aria-label="Cerrar"
        class="absolute top-2 right-2 z-10 flex items-center justify-center w-8 h-8 rounded-full bg-off-white text-gris cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
      <img src={activePromo.image_path} alt={activePromo.title || 'Promo actual'} class="w-full block max-h-[80vh] object-contain" />
    </div>
  </div>
)}

<script>
  const popup = document.getElementById('promo-popup');
  const trigger = document.getElementById('promos-trigger');

  if (popup) {
    const open = () => popup.classList.remove('hidden');
    const close = () => popup.classList.add('hidden');

    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      open();
    });

    popup.addEventListener('click', (e) => {
      if (e.target === popup) close();
    });

    document.getElementById('promo-popup-close')
      ?.addEventListener('click', close);
  }
</script>
