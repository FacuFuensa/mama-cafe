---
import { whatsappURL } from '../data/contact.ts';
---

<section class="relative w-full min-h-screen flex flex-col items-center justify-center">
  <div class="max-w-2xl md:max-w-3xl mx-auto px-4 text-center">

    <h1 class="font-sans font-bold text-5xl md:text-7xl text-gris tracking-tight leading-none">
      măma café
    </h1>

    <div class="h-px w-12 bg-dulce mx-auto my-8" aria-hidden="true"></div>

    <p class="font-display italic text-2xl md:text-3xl text-gris/80 leading-snug">
      Una taza de café, una charla.
    </p>

    <p class="mt-6 text-xs md:text-sm tracking-[0.2em] uppercase text-gris/60">
      Café de especialidad · Yerba Buena, Tucumán
    </p>

    <div class="flex flex-col items-center gap-4 mt-12">
      <a
        href="#menu"
        class="text-xs tracking-[0.2em] uppercase font-semibold text-dulce hover:text-choco"
      >
        Ver la carta ↓
      </a>

      <a
        href={whatsappURL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs tracking-[0.2em] uppercase text-gris/60 hover:text-dulce transition-colors duration-200"
      >
        Pedí o reservá
      </a>
    </div>

  </div>

  <a
    href="#horarios"
    aria-label="Desplazarse a horarios"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-2xl text-gris/40 hover:text-dulce transition-colors duration-200 animate-soft-pulse"
  >
    ↓
  </a>
</section>
