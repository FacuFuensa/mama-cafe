---
import { whatsappURL } from '../data/contact.ts';
---

<section class="w-full py-20 md:py-32">
  <div class="max-w-2xl mx-auto px-4 text-center">

    <h1 class="font-sans font-bold text-5xl md:text-7xl text-gris tracking-tight leading-none">
      măma café
    </h1>

    <div class="h-px w-12 bg-dulce mx-auto my-8" aria-hidden="true"></div>

    <p class="font-display italic text-2xl md:text-3xl text-gris/80 leading-snug">
      un café con espuma, por favor.
    </p>

    <p class="mt-6 text-xs md:text-sm tracking-[0.2em] uppercase text-gris/60">
      Café de especialidad · Yerba Buena, Tucumán
    </p>

    <a
      href="#menu"
      class="inline-block mt-12 text-xs tracking-[0.2em] uppercase font-semibold text-dulce hover:text-choco"
    >
      Ver la carta ↓
    </a>

    <a
      href={whatsappURL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mt-4 text-xs tracking-[0.2em] uppercase text-gris/60 hover:text-dulce transition-colors duration-200"
    >
      Pedí o reservá
    </a>

  </div>
</section>
