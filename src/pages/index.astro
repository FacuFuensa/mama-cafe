---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MenuSectionComponent from '../components/MenuSection.astro';
import MenuNav from '../components/MenuNav.astro';
import Horarios from '../components/Horarios.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Footer from '../components/Footer.astro';
import { menu } from '../data/menu.ts';
import { superCategories } from '../data/categories.ts';
---

<BaseLayout
  title="Māma Café | Café de especialidad en Yerba Buena"
  description="Una taza de café, una charla. Café de especialidad en Yerba Buena, Tucumán."
>
  <Hero />

  <section id="menu">
    <main class="max-w-2xl mx-auto px-4 py-16 md:py-24">
      <h2 class="text-3xl md:text-4xl font-light text-gris text-center mb-8">Carta</h2>

      <MenuNav />

      {superCategories.map(({ anchor, sections: sectionNames }) => {
        const groupSections = menu.filter(s => sectionNames.includes(s.category));
        return (
          <div id={anchor} data-menu-group={anchor} class="scroll-mt-20 pt-10">
            {groupSections.map(section => (
              <MenuSectionComponent section={section} />
            ))}
          </div>
        );
      })}
    </main>
  </section>

  <Horarios />

  <Ubicacion />

  <Footer />
</BaseLayout>
