---
import { supabaseAdmin } from '../../lib/supabase-admin';
import '../../styles/global.css';

const [{ data: categories }, { data: items }] = await Promise.all([
  supabaseAdmin
    .from('categories')
    .select('id, name')
    .order('display_order'),
  supabaseAdmin
    .from('menu_items')
    .select('id, category_id, name, description, price, optional, is_active, image_path')
    .order('display_order'),
]);

type CatRow = { id: string; name: string };
type ItemRow = {
  id: string;
  category_id: string;
  name: string;
  description: string;
  price: number;
  optional: string | null;
  is_active: boolean;
  image_path: string | null;
};

const sections = ((categories ?? []) as CatRow[])
  .map((cat) => {
    const all = ((items ?? []) as ItemRow[]).filter((i) => i.category_id === cat.id);
    return {
      ...cat,
      activeItems: all.filter((i) => i.is_active),
      inactiveItems: all.filter((i) => !i.is_active),
    };
  })
  .filter((c) => c.activeItems.length > 0 || c.inactiveItems.length > 0);
---

<!DOCTYPE html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — Māma Café</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-off-white text-gris font-sans min-h-screen">
    <div class="max-w-xl mx-auto px-4 py-10 pb-32">

      <header class="flex items-center justify-between mb-6">
        <h1 class="text-lg font-light tracking-widest lowercase">
          <span class="font-semibold">măma café</span> — admin
        </h1>
        <a href="/" class="text-sm text-dulce hover:underline">← ver sitio</a>
      </header>

      <nav class="flex gap-6 mb-10">
        <a
          href="/admin/events"
          class="text-xs font-semibold uppercase tracking-widest text-choco/40 hover:text-choco/70 transition-colors pb-1"
        >
          Eventos
        </a>
        <a
          href="/admin/menu"
          class="text-xs font-semibold uppercase tracking-widest text-choco border-b-2 border-dulce pb-1"
        >
          Carta
        </a>
      </nav>

      {sections.length === 0 ? (
        <p class="text-sm text-choco italic">No hay ítems en la carta.</p>
      ) : (
        sections.map((section) => (
          <section class="mb-10">
            <h2 class="text-xs font-semibold uppercase tracking-widest text-choco mb-3">
              {section.name}
            </h2>

            <div class="divide-y divide-choco/10">
              {section.activeItems.map((item) => (
                <div id={`item-${item.id}`}>
                  <div class="item-view flex items-center justify-between gap-2 py-2.5">
                    <span class="text-sm flex-1 min-w-0 truncate">{item.name}</span>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <span class="text-xs text-choco/50 select-none">$</span>
                      <input
                        type="number"
                        data-id={item.id}
                        data-original={String(item.price)}
                        value={item.price}
                        min="0"
                        step="1"
                        class="price-input w-20 px-2 py-1 text-sm text-right rounded-lg border border-gris/20 bg-white/60 focus:outline-none focus:border-dulce transition-colors"
                      />
                      <button
                        type="button"
                        class="edit-btn px-2.5 py-1 text-xs rounded-lg border border-gris/25 hover:border-gris transition-colors cursor-pointer whitespace-nowrap"
                        data-id={item.id}
                      >
                        Editar
                      </button>
                      <button
                        type="button"
                        class="toggle-item-btn px-2.5 py-1 text-xs rounded-lg border border-choco/20 text-choco/50 hover:border-ladrillo hover:text-ladrillo transition-colors cursor-pointer whitespace-nowrap"
                        data-id={item.id}
                        data-active="true"
                      >
                        Desactivar
                      </button>
                    </div>
                  </div>
                  <div class="item-edit hidden bg-white/50 rounded-xl p-4 mb-2 space-y-3 border border-choco/10">
                    <div>
                      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Nombre</label>
                      <input
                        type="text"
                        name="name"
                        value={item.name}
                        class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                      />
                    </div>
                    <div>
                      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Descripción</label>
                      <textarea
                        name="description"
                        rows={2}
                        class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors resize-none"
                      >{item.description}</textarea>
                    </div>
                    <div>
                      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Precio</label>
                      <input
                        type="number"
                        name="price"
                        value={item.price}
                        min="0"
                        step="1"
                        class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                      />
                    </div>
                    <div>
                      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Opcional</label>
                      <input
                        type="text"
                        name="optional"
                        value={item.optional ?? ''}
                        placeholder="ej. Elegí tu sabor: Clásico, Pistacho"
                        class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                      />
                    </div>
                    <div>
                      <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Imagen</label>
                      <img
                        id={`img-preview-edit-${item.id}`}
                        src={item.image_path ?? ''}
                        alt=""
                        class={`h-20 w-28 rounded-lg object-cover border border-choco/10 mb-1${!item.image_path ? ' hidden' : ''}`}
                      />
                      {item.image_path && (
                        <button
                          type="button"
                          class="remove-img-btn block text-xs text-ladrillo/60 hover:text-ladrillo mb-2 cursor-pointer"
                          data-id={item.id}
                          data-image-path={item.image_path}
                        >
                          Quitar imagen
                        </button>
                      )}
                      <input
                        type="file"
                        accept="image/*"
                        id={`img-input-edit-${item.id}`}
                        class="w-full text-xs text-gris file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-dulce/10 file:text-gris hover:file:bg-dulce/20 file:cursor-pointer cursor-pointer"
                      />
                    </div>
                    <div class="flex gap-2 pt-1">
                      <button
                        type="button"
                        class="save-edit-btn flex-1 py-2 rounded-lg bg-gris text-off-white text-sm font-semibold hover:bg-dark-choco transition-colors cursor-pointer"
                        data-id={item.id}
                      >
                        Guardar
                      </button>
                      <button
                        type="button"
                        class="cancel-edit-btn px-4 py-2 rounded-lg border border-gris/30 text-sm hover:border-gris transition-colors cursor-pointer"
                        data-id={item.id}
                      >
                        Cancelar
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            {section.inactiveItems.length > 0 && (
              <div class="mt-4 opacity-60">
                <p class="text-xs text-choco/50 font-medium mb-2">Inactivos</p>
                <div class="divide-y divide-choco/10">
                  {section.inactiveItems.map((item) => (
                    <div id={`item-${item.id}`} class="flex items-center justify-between gap-3 py-2">
                      <span class="text-sm flex-1 min-w-0 truncate line-through decoration-choco/30">{item.name}</span>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <button
                          type="button"
                          class="toggle-item-btn px-2.5 py-1 text-xs rounded-lg border border-dulce/40 text-dulce/70 hover:border-dulce hover:text-dulce transition-colors cursor-pointer whitespace-nowrap"
                          data-id={item.id}
                          data-active="false"
                        >
                          Activar
                        </button>
                        <button
                          type="button"
                          class="hard-delete-btn px-2.5 py-1 text-xs rounded-lg border border-ladrillo/30 text-ladrillo/60 hover:border-ladrillo hover:text-ladrillo transition-colors cursor-pointer whitespace-nowrap"
                          data-id={item.id}
                          data-image-path={item.image_path ?? ''}
                        >
                          Eliminar
                        </button>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div class="mt-4">
              <button
                type="button"
                class="show-add-btn w-full py-2 text-xs font-semibold uppercase tracking-wider text-choco/40 hover:text-choco/70 border border-dashed border-choco/15 hover:border-choco/30 rounded-lg transition-colors cursor-pointer"
                data-cat-id={section.id}
              >
                + Agregar ítem
              </button>
              <div id={`add-wrap-${section.id}`} class="hidden mt-3 bg-white/50 rounded-xl p-4 space-y-3 border border-choco/10">
                <p class="text-xs font-semibold uppercase tracking-wider text-choco/60">Nuevo ítem</p>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Nombre *</label>
                  <input
                    type="text"
                    name="name"
                    class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Descripción</label>
                  <textarea
                    name="description"
                    rows={2}
                    class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors resize-none"
                  ></textarea>
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Precio *</label>
                  <input
                    type="number"
                    name="price"
                    min="0"
                    step="1"
                    class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Opcional</label>
                  <input
                    type="text"
                    name="optional"
                    placeholder="ej. Elegí tu sabor: Clásico, Pistacho"
                    class="w-full px-3 py-2 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                  />
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider mb-1.5">Imagen</label>
                  <img
                    id={`img-preview-add-${section.id}`}
                    src=""
                    alt=""
                    class="hidden h-20 w-28 rounded-lg object-cover border border-choco/10 mb-2"
                  />
                  <input
                    type="file"
                    accept="image/*"
                    id={`img-input-add-${section.id}`}
                    class="w-full text-xs text-gris file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-dulce/10 file:text-gris hover:file:bg-dulce/20 file:cursor-pointer cursor-pointer"
                  />
                </div>
                <div class="flex gap-2 pt-1">
                  <button
                    type="button"
                    class="save-add-btn flex-1 py-2 rounded-lg bg-gris text-off-white text-sm font-semibold hover:bg-dark-choco transition-colors cursor-pointer"
                    data-cat-id={section.id}
                  >
                    Agregar
                  </button>
                  <button
                    type="button"
                    class="cancel-add-btn px-4 py-2 rounded-lg border border-gris/30 text-sm hover:border-gris transition-colors cursor-pointer"
                    data-cat-id={section.id}
                  >
                    Cancelar
                  </button>
                </div>
              </div>
            </div>

          </section>
        ))
      )}

    </div>

    <!-- Sticky save bar (bulk price update) -->
    <div
      id="save-bar"
      class="fixed bottom-0 left-0 right-0 hidden bg-off-white/95 backdrop-blur border-t border-choco/15 px-4 py-4"
    >
      <div class="max-w-xl mx-auto">
        <button
          id="save-btn"
          class="w-full py-3 rounded-xl bg-gris text-off-white text-sm font-semibold tracking-wider hover:bg-dark-choco transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Guardar cambios
        </button>
      </div>
    </div>

    <script>
      // ---- Bulk price save ----
      const priceInputs = document.querySelectorAll<HTMLInputElement>('.price-input');
      const saveBar = document.getElementById('save-bar')!;
      const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
      const changes = new Map<string, number>();

      function updateSaveBar() {
        if (changes.size === 0) { saveBar.classList.add('hidden'); return; }
        saveBar.classList.remove('hidden');
        const label = changes.size === 1 ? '1 cambio' : `${changes.size} cambios`;
        saveBtn.textContent = `Guardar ${label}`;
      }

      priceInputs.forEach((input) => {
        input.addEventListener('input', () => {
          const id = input.dataset.id!;
          const original = Number(input.dataset.original);
          const current = Math.round(Number(input.value));
          if (!isNaN(current) && current >= 0 && current !== original) {
            changes.set(id, current);
            input.classList.add('bg-yellow-100', 'border-dulce');
            input.classList.remove('bg-white/60');
          } else {
            changes.delete(id);
            input.classList.remove('bg-yellow-100', 'border-dulce');
            input.classList.add('bg-white/60');
          }
          updateSaveBar();
        });
      });

      saveBtn.addEventListener('click', async () => {
        if (changes.size === 0 || saveBtn.disabled) return;
        const label = changes.size === 1 ? '1 cambio' : `${changes.size} cambios`;
        saveBtn.textContent = 'Guardando...';
        saveBtn.disabled = true;
        const updates = Array.from(changes.entries()).map(([id, price]) => ({ id, price }));
        try {
          const res = await fetch('/api/admin/update-prices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ updates }),
          });
          const json = await res.json();
          if (json.success) {
            location.reload();
          } else {
            alert(`Error: ${json.error}`);
            saveBtn.textContent = `Guardar ${label}`;
            saveBtn.disabled = false;
          }
        } catch {
          alert('Error de red. Intentá de nuevo.');
          saveBtn.textContent = `Guardar ${label}`;
          saveBtn.disabled = false;
        }
      });

      // ---- Image compression ----
      async function compressImage(file: File, maxWidth = 1200, quality = 0.8): Promise<Blob> {
        if (file.size < 1024 * 1024) return file;
        return new Promise((resolve, reject) => {
          const url = URL.createObjectURL(file);
          const img = new Image();
          img.onload = () => {
            URL.revokeObjectURL(url);
            const scale = Math.min(1, maxWidth / Math.max(img.width, img.height));
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(
              (blob) => blob ? resolve(blob) : reject(new Error('Canvas toBlob failed')),
              'image/jpeg',
              quality
            );
          };
          img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Image load failed')); };
          img.src = url;
        });
      }

      // ---- Image preview listeners ----
      document.querySelectorAll<HTMLInputElement>('[id^="img-input-edit-"]').forEach((input) => {
        input.addEventListener('change', () => {
          const id = input.id.slice('img-input-edit-'.length);
          const preview = document.getElementById(`img-preview-edit-${id}`) as HTMLImageElement;
          if (input.files?.[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.classList.remove('hidden');
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('[id^="img-input-add-"]').forEach((input) => {
        input.addEventListener('change', () => {
          const catId = input.id.slice('img-input-add-'.length);
          const preview = document.getElementById(`img-preview-add-${catId}`) as HTMLImageElement;
          if (input.files?.[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.classList.remove('hidden');
          }
        });
      });

      // ---- Edit item ----
      document.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const wrap = document.getElementById(`item-${btn.dataset.id}`)!;
          wrap.querySelector('.item-view')!.classList.add('hidden');
          wrap.querySelector('.item-edit')!.classList.remove('hidden');
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.cancel-edit-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const wrap = document.getElementById(`item-${btn.dataset.id}`)!;
          wrap.querySelector('.item-view')!.classList.remove('hidden');
          wrap.querySelector('.item-edit')!.classList.add('hidden');
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.save-edit-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id!;
          const wrap = document.getElementById(`item-${id}`)!;
          const form = wrap.querySelector('.item-edit')!;
          const name = (form.querySelector('[name="name"]') as HTMLInputElement).value.trim();
          const description = (form.querySelector('[name="description"]') as HTMLTextAreaElement).value.trim();
          const price = Number((form.querySelector('[name="price"]') as HTMLInputElement).value);
          const optionalRaw = (form.querySelector('[name="optional"]') as HTMLInputElement).value.trim();
          const optional = optionalRaw || null;
          const imageInput = document.getElementById(`img-input-edit-${id}`) as HTMLInputElement;
          const imageFile = imageInput?.files?.[0] ?? null;

          if (!name || isNaN(price) || price < 0) {
            alert('Completá el nombre y un precio válido.');
            return;
          }

          btn.textContent = 'Guardando...';
          btn.disabled = true;

          try {
            if (imageFile) {
              btn.textContent = 'Subiendo imagen...';
              const compressed = await compressImage(imageFile);
              const fd = new FormData();
              fd.append('image', compressed, imageFile.name.replace(/\.[^.]+$/, '.jpg'));
              fd.append('item_id', id);
              const imgRes = await fetch('/api/admin/upload-menu-image', { method: 'POST', body: fd });
              const imgJson = await imgRes.json();
              if (!imgJson.success) {
                alert(`Error al subir imagen: ${imgJson.error}`);
                btn.textContent = 'Guardar';
                btn.disabled = false;
                return;
              }
              btn.textContent = 'Guardando...';
            }

            const res = await fetch('/api/admin/update-item', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, name, description, price: Math.round(price), optional }),
            });
            const json = await res.json();
            if (json.success) {
              location.reload();
            } else {
              alert(`Error: ${json.error}`);
              btn.textContent = 'Guardar';
              btn.disabled = false;
            }
          } catch {
            alert('Error de red. Intentá de nuevo.');
            btn.textContent = 'Guardar';
            btn.disabled = false;
          }
        });
      });

      // ---- Toggle item (activate / deactivate) ----
      document.querySelectorAll<HTMLButtonElement>('.toggle-item-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id!;
          const isActive = btn.dataset.active === 'true';

          if (isActive && !confirm('¿Desactivar este ítem? Va a dejar de mostrarse en la carta.')) return;

          btn.textContent = 'Guardando...';
          btn.disabled = true;

          try {
            const res = await fetch('/api/admin/toggle-item', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, is_active: !isActive }),
            });
            const json = await res.json();
            if (json.success) {
              location.reload();
            } else {
              alert(`Error: ${json.error}`);
              btn.textContent = isActive ? 'Desactivar' : 'Activar';
              btn.disabled = false;
            }
          } catch {
            alert('Error de red.');
            btn.textContent = isActive ? 'Desactivar' : 'Activar';
            btn.disabled = false;
          }
        });
      });

      // ---- Add item ----
      document.querySelectorAll<HTMLButtonElement>('.show-add-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          btn.classList.add('hidden');
          document.getElementById(`add-wrap-${btn.dataset.catId}`)!.classList.remove('hidden');
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.cancel-add-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const catId = btn.dataset.catId!;
          document.getElementById(`add-wrap-${catId}`)!.classList.add('hidden');
          document.querySelector<HTMLButtonElement>(`.show-add-btn[data-cat-id="${catId}"]`)!.classList.remove('hidden');
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.save-add-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const catId = btn.dataset.catId!;
          const wrap = document.getElementById(`add-wrap-${catId}`)!;
          const name = (wrap.querySelector('[name="name"]') as HTMLInputElement).value.trim();
          const description = (wrap.querySelector('[name="description"]') as HTMLTextAreaElement).value.trim();
          const price = Number((wrap.querySelector('[name="price"]') as HTMLInputElement).value);
          const optionalRaw = (wrap.querySelector('[name="optional"]') as HTMLInputElement).value.trim();
          const optional = optionalRaw || null;
          const imageInput = document.getElementById(`img-input-add-${catId}`) as HTMLInputElement;
          const imageFile = imageInput?.files?.[0] ?? null;

          if (!name || isNaN(price) || price < 0) {
            alert('Completá el nombre y un precio válido.');
            return;
          }

          btn.textContent = 'Guardando...';
          btn.disabled = true;

          try {
            let image_path: string | null = null;

            if (imageFile) {
              btn.textContent = 'Subiendo imagen...';
              const compressed = await compressImage(imageFile);
              const fd = new FormData();
              fd.append('image', compressed, imageFile.name.replace(/\.[^.]+$/, '.jpg'));
              const imgRes = await fetch('/api/admin/upload-menu-image', { method: 'POST', body: fd });
              const imgJson = await imgRes.json();
              if (!imgJson.success) {
                alert(`Error al subir imagen: ${imgJson.error}`);
                btn.textContent = 'Agregar';
                btn.disabled = false;
                return;
              }
              image_path = imgJson.url;
              btn.textContent = 'Guardando...';
            }

            const res = await fetch('/api/admin/add-item', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ category_id: catId, name, description, price: Math.round(price), optional, image_path }),
            });
            const json = await res.json();
            if (json.success) {
              location.reload();
            } else {
              alert(`Error: ${json.error}`);
              btn.textContent = 'Agregar';
              btn.disabled = false;
            }
          } catch {
            alert('Error de red.');
            btn.textContent = 'Agregar';
            btn.disabled = false;
          }
        });
      });
      // ---- Remove image ----
      document.querySelectorAll<HTMLButtonElement>('.remove-img-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id!;
          const imagePath = btn.dataset.imagePath!;

          btn.textContent = 'Quitando...';
          btn.disabled = true;

          try {
            const res = await fetch('/api/admin/remove-menu-image', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, image_path: imagePath }),
            });
            const json = await res.json();
            if (json.success) {
              const preview = document.getElementById(`img-preview-edit-${id}`) as HTMLImageElement;
              preview.classList.add('hidden');
              preview.src = '';
              (document.getElementById(`img-input-edit-${id}`) as HTMLInputElement).value = '';
              btn.remove();
            } else {
              alert(`Error: ${json.error}`);
              btn.textContent = 'Quitar imagen';
              btn.disabled = false;
            }
          } catch {
            alert('Error de red.');
            btn.textContent = 'Quitar imagen';
            btn.disabled = false;
          }
        });
      });

      // ---- Hard delete item ----
      document.querySelectorAll<HTMLButtonElement>('.hard-delete-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id!;

          if (!confirm('¿Eliminar definitivamente este ítem? Esta acción no se puede deshacer.')) return;

          btn.textContent = 'Eliminando...';
          btn.disabled = true;

          try {
            const res = await fetch('/api/admin/delete-item', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id }),
            });
            const json = await res.json();
            if (json.success) {
              document.getElementById(`item-${id}`)?.remove();
            } else {
              alert(`Error: ${json.error}`);
              btn.textContent = 'Eliminar';
              btn.disabled = false;
            }
          } catch {
            alert('Error de red.');
            btn.textContent = 'Eliminar';
            btn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
