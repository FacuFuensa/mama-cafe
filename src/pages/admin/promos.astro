---
import { supabaseAdmin } from '../../lib/supabase-admin';
import '../../styles/global.css';

const { data: promos } = await supabaseAdmin
  .from('promos')
  .select('id, title, image_path, is_active, expires_at, created_at')
  .order('created_at', { ascending: false });

const allPromos = promos ?? [];
const activePromo = allPromos.find((p) => p.is_active) ?? null;

const todayStr = new Date().toISOString().split('T')[0];
const isExpired = (expires_at: string | null) =>
  expires_at != null && expires_at < todayStr;

const formatDate = (d: string) => {
  const [y, m, day] = d.split('-');
  return `${day}/${m}/${y}`;
};
const formatDateTime = (iso: string) => formatDate(iso.split('T')[0]);

const statusLabel = (p: { is_active: boolean; expires_at: string | null }) => {
  if (isExpired(p.expires_at)) return { text: '● Vencida', cls: 'text-ladrillo' };
  if (p.is_active) return { text: '● Activa', cls: 'text-dulce' };
  return { text: '○ Inactiva', cls: 'text-choco/60' };
};
---

<!DOCTYPE html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — Māma Café</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-off-white text-gris font-sans min-h-screen">
    <div class="max-w-xl mx-auto px-4 py-10 pb-32">

      <header class="flex items-center justify-between mb-6">
        <h1 class="text-lg font-light tracking-widest lowercase">
          <span class="font-semibold">măma café</span> — admin
        </h1>
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm text-dulce hover:underline">← ver sitio</a>
          <form method="POST" action="/api/admin/logout">
            <button type="submit" class="text-sm text-dulce hover:underline">Cerrar sesión</button>
          </form>
        </div>
      </header>

      <nav class="flex gap-6 mb-10">
        <a
          href="/admin/events"
          class="text-xs font-semibold uppercase tracking-widest text-choco/40 hover:text-choco/70 transition-colors pb-1"
        >
          Eventos
        </a>
        <a
          href="/admin/menu"
          class="text-xs font-semibold uppercase tracking-widest text-choco/40 hover:text-choco/70 transition-colors pb-1"
        >
          Carta
        </a>
        <a
          href="/admin/promos"
          class="text-xs font-semibold uppercase tracking-widest text-choco border-b-2 border-dulce pb-1"
        >
          Promos
        </a>
      </nav>

      <!-- Promo activa -->
      <section class="mb-10">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-choco mb-4">
          Promo activa
        </h2>

        {activePromo ? (
          <div class="rounded-xl overflow-hidden border border-choco/20 bg-white/50">
            <img
              src={activePromo.image_path}
              alt={activePromo.title}
              class="w-full h-52 object-cover"
            />
            <div class="p-4 flex items-center justify-between gap-3">
              <div>
                <p class="font-semibold text-sm">{activePromo.title}</p>
                {(() => {
                  const s = statusLabel(activePromo);
                  return <p class={`text-xs mt-1 ${s.cls}`}>{s.text}</p>;
                })()}
                <p class="text-xs mt-1 text-choco/50">
                  {activePromo.expires_at
                    ? `Vigencia hasta ${formatDate(activePromo.expires_at)}`
                    : 'Sin vencimiento'}
                </p>
              </div>
              <div class="shrink-0">
                <button
                  data-toggle-btn
                  data-id={activePromo.id}
                  data-active="true"
                  class="px-3 py-1.5 text-xs rounded-lg border border-gris/30 hover:border-gris transition-colors cursor-pointer"
                >
                  Desactivar
                </button>
              </div>
            </div>
          </div>
        ) : (
          <p class="text-sm text-choco italic">No hay ninguna promo activa.</p>
        )}
      </section>

      <!-- Subir nueva promo -->
      <section class="mb-10">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-choco mb-4">
          Subir nueva promo
        </h2>

        <form id="upload-form" class="space-y-4">
          <div>
            <label for="title" class="block text-xs font-semibold uppercase tracking-wider mb-1.5">
              Título
            </label>
            <input
              id="title"
              name="title"
              type="text"
              required
              placeholder="ej. 2x1 en cafés · todo agosto"
              class="w-full px-3 py-2.5 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
            />
          </div>

          <div>
            <label for="image" class="block text-xs font-semibold uppercase tracking-wider mb-1.5">
              Imagen
            </label>
            <input
              id="image"
              name="image"
              type="file"
              accept="image/*"
              required
              class="w-full text-sm text-gris file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-dulce file:text-off-white hover:file:bg-choco file:cursor-pointer cursor-pointer"
            />
          </div>

          <div>
            <label for="expires_at" class="block text-xs font-semibold uppercase tracking-wider mb-1.5">
              Vigencia (hasta)
            </label>
            <input
              id="expires_at"
              name="expires_at"
              type="date"
              class="w-full px-3 py-2.5 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
            />
            <p class="text-xs text-choco/50 mt-1">Opcional — dejalo vacío para que no venza.</p>
          </div>

          <p id="status-msg" class="text-sm hidden"></p>

          <button
            id="submit-btn"
            type="submit"
            class="w-full py-2.5 rounded-lg bg-gris text-off-white text-sm font-semibold tracking-wider hover:bg-dark-choco transition-colors cursor-pointer"
          >
            Subir promo
          </button>
        </form>
      </section>

      <!-- Historial de promos -->
      <section>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-choco mb-4">
          Historial de promos
        </h2>

        {allPromos.length === 0 ? (
          <p class="text-sm text-choco italic">Todavía no se subió ninguna promo.</p>
        ) : (
          <div class="space-y-3">
            {allPromos.map((p) => {
              const s = statusLabel(p);
              return (
                <div class="rounded-xl border border-choco/15 bg-white/40 p-2.5">
                  <div class="flex items-center gap-3">
                    <img
                      src={p.image_path}
                      alt={p.title}
                      class="w-16 h-16 rounded-lg object-cover shrink-0"
                    />
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold text-sm truncate">{p.title}</p>
                      <p class={`text-xs mt-0.5 ${s.cls}`}>{s.text}</p>
                      <p class="text-xs mt-0.5 text-choco/50">
                        Subida el {formatDateTime(p.created_at)}
                        {p.expires_at ? ` · vence ${formatDate(p.expires_at)}` : ''}
                      </p>
                    </div>
                    {!p.is_active && (
                      <button
                        data-activate-btn
                        data-id={p.id}
                        class="shrink-0 px-3 py-1.5 text-xs rounded-lg border border-gris/30 hover:border-gris transition-colors cursor-pointer"
                      >
                        Activar
                      </button>
                    )}
                  </div>

                  {!p.is_active && (
                    <form
                      data-activate-form
                      data-id={p.id}
                      class="hidden mt-3 pt-3 border-t border-choco/10"
                    >
                      <label class="block text-xs font-semibold uppercase tracking-wider text-choco/70 mb-1.5">
                        Nueva vigencia (hasta)
                      </label>
                      <div class="flex flex-wrap items-center gap-2">
                        <input
                          type="date"
                          value={p.expires_at ?? ''}
                          class="flex-1 min-w-[8rem] px-2 py-1.5 rounded-lg border border-gris/25 bg-white/60 text-sm focus:outline-none focus:border-dulce transition-colors"
                        />
                        <button
                          type="submit"
                          data-confirm-btn
                          class="px-3 py-1.5 text-xs rounded-lg bg-gris text-off-white hover:bg-dark-choco transition-colors cursor-pointer"
                        >
                          Confirmar
                        </button>
                        <a
                          href="#"
                          data-cancel-btn
                          data-id={p.id}
                          class="text-xs text-choco/60 hover:underline cursor-pointer"
                        >
                          Cancelar
                        </a>
                      </div>
                      <p class="text-xs text-choco/50 mt-1.5">Dejalo vacío para que no venza.</p>
                    </form>
                  )}
                </div>
              );
            })}
          </div>
        )}
      </section>

    </div>

    <script>
      const form = document.getElementById('upload-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const statusMsg = document.getElementById('status-msg') as HTMLElement;

      function showStatus(msg: string, ok: boolean) {
        statusMsg.textContent = msg;
        statusMsg.className = `text-sm ${ok ? 'text-dulce' : 'text-ladrillo'}`;
      }

      async function compressImage(file: File, maxWidth = 1200, quality = 0.8): Promise<Blob> {
        if (file.size < 1024 * 1024) return file;

        return new Promise((resolve, reject) => {
          const url = URL.createObjectURL(file);
          const img = new Image();
          img.onload = () => {
            URL.revokeObjectURL(url);
            const scale = Math.min(1, maxWidth / Math.max(img.width, img.height));
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            canvas.getContext('2d')!.drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(
              (blob) => blob ? resolve(blob) : reject(new Error('Canvas toBlob failed')),
              'image/jpeg',
              quality
            );
          };
          img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Image load failed')); };
          img.src = url;
        });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.textContent = 'Subiendo...';
        submitBtn.disabled = true;

        try {
          const imageInput = form.elements.namedItem('image') as HTMLInputElement;
          const originalFile = imageInput.files![0];
          const compressed = await compressImage(originalFile);
          const fd = new FormData(form);
          fd.set('image', compressed, originalFile.name.replace(/\.[^.]+$/, '.jpg'));

          const res = await fetch('/api/admin/upload-promo', {
            method: 'POST',
            body: fd,
          });
          const json = await res.json();

          if (json.success) {
            showStatus('¡Promo subida con éxito!', true);
            setTimeout(() => location.reload(), 800);
          } else {
            showStatus(`Error: ${json.error}`, false);
            submitBtn.textContent = 'Subir promo';
            submitBtn.disabled = false;
          }
        } catch {
          showStatus('Error de red. Intentá de nuevo.', false);
          submitBtn.textContent = 'Subir promo';
          submitBtn.disabled = false;
        }
      });

      document.querySelectorAll<HTMLButtonElement>('[data-toggle-btn]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.dataset.id!;
          const currentActive = btn.dataset.active === 'true';
          const original = btn.textContent;
          btn.textContent = 'Guardando...';
          btn.disabled = true;

          try {
            const res = await fetch('/api/admin/toggle-promo', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, is_active: !currentActive }),
            });
            const json = await res.json();

            if (json.success) {
              location.reload();
            } else {
              alert(`Error: ${json.error}`);
              btn.textContent = original;
              btn.disabled = false;
            }
          } catch {
            alert('Error de red.');
            btn.textContent = original;
            btn.disabled = false;
          }
        });
      });

      // History: "Activar" reveals an inline expiration form before activating.
      document.querySelectorAll<HTMLButtonElement>('[data-activate-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id!;
          const formEl = document.querySelector<HTMLFormElement>(`[data-activate-form][data-id="${id}"]`)!;
          btn.classList.add('hidden');
          formEl.classList.remove('hidden');
        });
      });

      document.querySelectorAll<HTMLAnchorElement>('[data-cancel-btn]').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const id = link.dataset.id!;
          const formEl = document.querySelector<HTMLFormElement>(`[data-activate-form][data-id="${id}"]`)!;
          const btn = document.querySelector<HTMLButtonElement>(`[data-activate-btn][data-id="${id}"]`)!;
          formEl.classList.add('hidden');
          btn.classList.remove('hidden');
        });
      });

      document.querySelectorAll<HTMLFormElement>('[data-activate-form]').forEach((formEl) => {
        formEl.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = formEl.dataset.id!;
          const dateInput = formEl.querySelector<HTMLInputElement>('input[type="date"]')!;
          const confirmBtn = formEl.querySelector<HTMLButtonElement>('[data-confirm-btn]')!;
          const expires_at = dateInput.value || null;
          const original = confirmBtn.textContent;
          confirmBtn.textContent = 'Guardando...';
          confirmBtn.disabled = true;

          try {
            const res = await fetch('/api/admin/toggle-promo', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id, is_active: true, expires_at }),
            });
            const json = await res.json();
            if (json.success) {
              location.reload();
            } else {
              alert(`Error: ${json.error}`);
              confirmBtn.textContent = original;
              confirmBtn.disabled = false;
            }
          } catch {
            alert('Error de red.');
            confirmBtn.textContent = original;
            confirmBtn.disabled = false;
          }
        });
      });
    </script>
  </body>
</html>
